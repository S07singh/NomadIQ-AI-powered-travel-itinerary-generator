# ============================================
# NomadIQ Backend — copy to .env and fill in
# ============================================

ENVIRONMENT=local                 # local | test | staging | production
LOG_LEVEL=INFO
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

# ─── MongoDB ────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nomadiq

# ─── Auth (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ─
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ─── LLM: mock | ollama | gemini ────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ─── Booking inventory (mock until partner keys) ────
FLIGHT_PROVIDER=mock              # mock | duffel
# DUFFEL_API_TOKEN=duffel_test_...
HOTEL_PROVIDER=mock               # mock | liteapi
# LITEAPI_API_KEY=
GROUND_PROVIDER=mock              # trains/buses — partner API needed
ACTIVITY_PROVIDER=mock
PAYMENT_PROVIDER=mock
OFFER_TTL_MINUTES=30

# ─── Visuals & live data (free defaults, no keys) ───
IMAGE_PROVIDER=wikipedia          # mock | wikipedia | unsplash | pexels
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
VIDEO_PROVIDER=youtube_link       # mock | youtube_link | youtube
# YOUTUBE_API_KEY=
WEATHER_PROVIDER=open_meteo       # mock | open_meteo (also geocoding)
KNOWLEDGE_PROVIDER=wikipedia      # mock | wikipedia

# ─── Voice (speech-to-text) ─────────────────────────
SPEECH_PROVIDER=mock              # mock | deepgram | openai
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
